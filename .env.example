# Gemini API (for topic extraction)
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic API (for trail generation with Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Database
DATABASE_PATH=data/database/syntopic.db

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Reranker Model
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Processing Parameters
TARGET_CHUNK_SIZE=500
CHUNK_TOLERANCE=0.2
TOPICS_PER_CHUNK=5
MIN_PMI_SCORE=0.5
NOVELTY_K_NEIGHBORS=10

# Agent Parameters
CLAUDE_MODEL=claude-opus-4-8
MAX_EXCERPTS_PER_TRAIL=10
