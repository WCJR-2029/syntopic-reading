# LLM Provider ("bring your own LLM" - see src/llm/client.py)
# Choose ONE provider. Default is Anthropic (Claude) - the whole pipeline
# (topic extraction + usefulness filtering + trail generation) runs on this
# single key, no Google/Gemini key required. Set LLM_PROVIDER=openai to use
# OpenAI or any OpenAI-compatible endpoint instead (OpenAI itself, OpenRouter,
# a local Ollama / LM Studio server, etc.).
LLM_PROVIDER=anthropic

# Model name for whichever provider is selected above.
# Anthropic example: claude-sonnet-5
# OpenAI example: gpt-4o-mini
# OpenRouter example: anthropic/claude-sonnet-5 or openai/gpt-4o-mini
LLM_MODEL=claude-sonnet-5

# --- Anthropic path (LLM_PROVIDER=anthropic, the default) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- OpenAI-compatible path (LLM_PROVIDER=openai) ---
OPENAI_API_KEY=your-openai-api-key-here
# Optional: point at an OpenAI-compatible endpoint instead of api.openai.com
# Examples: https://openrouter.ai/api/v1  |  http://localhost:11434/v1 (Ollama)
# OPENAI_BASE_URL=

# Database
DATABASE_PATH=data/database/syntopic.db

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Processing Parameters
TARGET_CHUNK_SIZE=500
CHUNK_TOLERANCE=0.2
TOPICS_PER_CHUNK=5
MIN_PMI_SCORE=0.5
NOVELTY_K_NEIGHBORS=10

# Agent Parameters
MAX_EXCERPTS_PER_TRAIL=10
